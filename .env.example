# Netlify build/runtime config (set exact URLs after creating both sites)
KATLEARN_LMS_SITE_URL=
KATLEARN_TEACHER_SITE_URL=
# Exact comma-separated origins allowed to call this site's API cross-origin
KATLEARN_ALLOWED_ORIGINS=

# Server-side Firebase Admin credentials (keep these in Netlify Environment Variables)
# Preferred: paste the complete service-account JSON as one value
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative when multiline formatting is inconvenient (Base64 is not encryption)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Or use all three fields together
# FIREBASE_PROJECT_ID=elp---katlearn
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
