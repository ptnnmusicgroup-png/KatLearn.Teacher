# Server-side Firebase Admin credentials
# Preferred: one JSON service account
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Alternative for Vercel / CI when multiline JSON is inconvenient
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=...

# Or use the three individual fields
# FIREBASE_PROJECT_ID=elp---katlearn
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@elp---katlearn.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
