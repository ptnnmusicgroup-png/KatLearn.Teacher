# KatLearn Teacher standalone Node.js server.
# Copy to .env.local. Never commit real credentials.
HOST=127.0.0.1
PORT=3100

# Firebase Admin credentials for project elp---katlearn.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# LMS backend URL. Local default assumes KatLearn LMS is running on port 3000.
# Set the production LMS URL when deploying the two apps.
KATLEARN_LMS_SITE_URL=http://127.0.0.1:3000
KATLEARN_TEACHER_SITE_URL=

# Exact browser origins allowed by Teacher API endpoints.
KATLEARN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
