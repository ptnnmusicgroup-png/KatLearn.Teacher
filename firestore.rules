rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'katlearn.admin@gmail.com'; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isPendingTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pending_teacher_verification';
    }
    function canManageClass(classId) {
      return isAdmin() || (isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid);
    }
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isAdmin() || ((isTeacher() || isPendingTeacher()) && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
      match /classes/{catalogClassId} {
        allow read: if true;
        allow create: if isAdmin() || ((isTeacher() || isPendingTeacher()) && request.resource.data.createdBy == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
    match /classInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin()
        || (isTeacher()
          && request.resource.data.teacherUid == request.auth.uid
          && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
          && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherUid == request.auth.uid);
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.classId == resource.data.classId
          && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherUid == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    match /classes/{classId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.teacherUid == resource.data.teacherUid);
      allow delete: if isAdmin();
      match /members/{memberId} {
        allow read: if canManageClass(classId) || (signedIn() && memberId == request.auth.uid);
        allow create, update, delete: if isAdmin();
      }
    }
    match /publicPacks/{packId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.createdByUid == request.auth.uid);
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid);
      allow delete: if isAdmin();
    }
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin()
        || (isTeacher()
          && resource.data.role != 'teacher'
          && resource.data.role != 'admin'
          && (resource.data.teacherUid == request.auth.uid
            || request.auth.uid in resource.data.get('teacherUids', []))));
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'student') in ['student', 'pending_teacher_verification']
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('energy', 0) == 0
        && request.resource.data.get('streak', 0) == 0
        && request.resource.data.get('lastStudyDay', '') == ''
        && request.resource.data.get('dailyQuestions', 0) == 0
        && request.resource.data.get('dailyCorrect', 0) == 0
        && request.resource.data.get('questionsAnswered', 0) == 0
        && request.resource.data.get('correctAnswers', 0) == 0
        && request.resource.data.get('ownedThemes', []) is list
        && request.resource.data.get('ownedThemes', []).size() == 0
        && request.resource.data.get('joinedClassIds', []) is list
        && request.resource.data.get('joinedClassIds', []).size() == 0
        && request.resource.data.get('teacherUid', '') == ''
        && request.resource.data.get('teacherUids', []) is list
        && request.resource.data.get('teacherUids', []).size() == 0;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'coins', 'energy', 'streak', 'lastStudyDay', 'dailyQuestions', 'dailyCorrect', 'questionsAnswered', 'correctAnswers',
            'ownedThemes', 'joinedClassIds', 'studentAccountType', 'teacherUid', 'teacherUids', 'classId', 'className', 'catalogClassId', 'schoolId', 'schoolName',
            'province', 'ward', 'teacherName', 'teacherEmail'
          ]));

      allow delete: if false;
      match /items/{itemId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /attempts/{attemptId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /personalPacks/{packId} {
        allow read, write: if signedIn() && request.auth.uid == userId
          && get(/databases/$(database)/documents/users/$(userId)).data.get('studentAccountType', 'free') != 'class';
      }
    }
  }
}