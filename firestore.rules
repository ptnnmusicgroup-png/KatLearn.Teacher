rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'katlearn.admin@gmail.com'; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isPendingTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pending_teacher_verification';
    }
    function canManageClass(classId) {
      return isAdmin() || (isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid);
    }
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isAdmin() || ((isTeacher() || isPendingTeacher()) && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
      match /classes/{catalogClassId} {
        allow read: if true;
        allow create: if isAdmin() || ((isTeacher() || isPendingTeacher()) && request.resource.data.createdBy == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
    match /classInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    match /classes/{classId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      match /members/{memberId} {
        allow read: if canManageClass(classId) || (signedIn() && memberId == request.auth.uid);
        allow create: if canManageClass(classId);
        allow update, delete: if canManageClass(classId);
      }
    }
    match /publicPacks/{packId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.createdByUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.createdByUid == request.auth.uid);
    }
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin()
        || (isTeacher() && resource.data.role != 'teacher' && resource.data.role != 'admin'));
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'student') in ['student', 'pending_teacher_verification'];
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'coins', 'energy', 'streak', 'questionsAnswered', 'correctAnswers',
            'ownedThemes', 'joinedClassIds', 'studentAccountType'
          ]))
        || (isTeacher() && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedClassIds', 'updatedAt']));
      allow delete: if false;
      match /items/{itemId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /attempts/{attemptId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /personalPacks/{packId} {
        allow read, write: if signedIn() && request.auth.uid == userId
          && get(/databases/$(database)/documents/users/$(userId)).data.get('studentAccountType', 'free') != 'class';
      }
    }
  }
}