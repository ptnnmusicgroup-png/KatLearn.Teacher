rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'katlearn.admin@gmail.com';
    }

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function canManageClass(classId) {
      return isAdmin()
        || (isTeacher()
          && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid);
    }

    match /classes/{classId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);

      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      match /members/{memberId} {
        allow read, write: if canManageClass(classId);
      }
    }

    match /publicPacks/{packId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.createdByUid == request.auth.uid);

      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.createdByUid == request.auth.uid);
    }

    match /users/{userId} {
      // Teachers/admins can read student profiles; ordinary students can only read themselves.
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || (isTeacher() && resource.data.role != 'teacher' && resource.data.role != 'admin')
      );

      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /items/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /attempts/{attemptId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}